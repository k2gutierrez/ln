# ============================================================
# ConIntención (ln) — Variables de entorno
# ============================================================
# 1. Copia este archivo:
#      cp .env.example .env.local
# 2. Rellena los valores reales en .env.local
# 3. Reinicia el servidor (npm run dev)
#
# .env.local NO se sube a git. Este .env.example SÍ se sube.
# ============================================================

# ---------- Supabase (obligatorio) ----------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo se usa en el servidor (API de comentarios), nunca en el navegador.
# NUNCA la prefijes con NEXT_PUBLIC_: quedaría expuesta al público.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# ---------- OpenAI (obligatorio para la IA y los comentarios) ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modelo del asistente de redacción (opcional; por defecto gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# ---------- SEO ----------
# URL pública del sitio, sin barra final. Se usa en metadatos, sitemap
# y Open Graph. En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Opcional ----------
# Google Analytics 4. Si está vacío, el script no se inyecta.
NEXT_PUBLIC_GA_ID=
